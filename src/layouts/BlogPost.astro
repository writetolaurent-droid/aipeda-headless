---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import '../styles/global.css';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={title} description={description} article={true} pubDate={pubDate} />
	</head>
	<body>
		<Header />
		<main class="article-main">
			<article class="article-container">
				<header class="article-header">
					<div class="article-date">
						<FormattedDate date={pubDate} />
						{updatedDate && (
							<span class="article-updated"> — Mis à jour le <FormattedDate date={updatedDate} /></span>
						)}
					</div>
					<h1 class="article-title">{title}</h1>
					<p class="article-desc">{description}</p>
				</header>

				<div class="article-content">
					<slot />
				</div>

			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.article-main {
		padding-top: 100px;
		max-width: 720px;
		margin: 0 auto;
		padding-left: 1.5rem;
		padding-right: 1.5rem;
		padding-bottom: 4rem;
	}

	.article-header {
		margin-bottom: 3rem;
		padding-bottom: 2rem;
		border-bottom: 1px solid var(--border);
	}

	.article-date {
		color: var(--text-muted);
		font-size: 0.9rem;
		margin-bottom: 0.75rem;
	}

	.article-updated {
		font-style: italic;
	}

	.article-title {
		font-size: clamp(1.8rem, 5vw, 2.6rem);
		line-height: 1.15;
		margin: 0 0 1rem 0;
		color: var(--navy);
		font-weight: 800;
		letter-spacing: -0.02em;
	}

	.article-desc {
		font-size: 1.15rem;
		color: var(--text-muted);
		line-height: 1.6;
		margin: 0;
	}

	/* Article content typography */
	.article-content {
		font-size: 1.05rem;
		line-height: 1.85;
		color: var(--text-body);
	}

	.article-content :global(h2) {
		font-size: 1.6rem;
		margin: 3rem 0 1rem 0;
		color: var(--navy);
		font-weight: 700;
	}

	.article-content :global(h3) {
		font-size: 1.25rem;
		margin: 2.5rem 0 0.75rem 0;
		color: var(--navy);
		font-weight: 700;
	}

	.article-content :global(p) {
		margin: 0 0 1.5rem 0;
	}

	.article-content :global(ul),
	.article-content :global(ol) {
		margin: 0 0 1.5rem 0;
		padding-left: 1.5rem;
	}

	.article-content :global(li) {
		margin-bottom: 0.5rem;
	}

	.article-content :global(blockquote) {
		border-left: 4px solid var(--amber);
		padding: 1rem 1.5rem;
		margin: 2rem 0;
		background: var(--surface);
		border-radius: 0 var(--radius-md) var(--radius-md) 0;
		font-style: italic;
		color: var(--text-muted);
	}

	.article-content :global(code) {
		background: rgba(217, 119, 87, 0.08);
		padding: 0.15rem 0.4rem;
		border-radius: 4px;
		font-size: 0.9em;
		font-family: 'Courier New', monospace;
	}

	.article-content :global(pre) {
		background: var(--navy) !important;
		border-radius: var(--radius-md);
		padding: 1.5rem;
		overflow-x: auto;
		margin: 2rem 0;
	}

	.article-content :global(pre code) {
		background: transparent;
		padding: 0;
		color: rgba(255, 255, 255, 0.9);
		font-size: 0.9rem;
		line-height: 1.6;
	}

	.article-content :global(img) {
		width: 100%;
		border-radius: var(--radius-md);
		margin: 2rem 0;
	}

	.article-content :global(a) {
		color: var(--amber);
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
		transition: color 0.2s;
	}

	.article-content :global(a:hover) {
		color: var(--navy);
	}

	.article-content :global(hr) {
		border: none;
		border-top: 1px solid var(--border);
		margin: 3rem 0;
	}

	/* Prompt blocks */
	.article-content :global(.prompt-block) {
		background: var(--navy);
		color: rgba(255, 255, 255, 0.95);
		border-radius: var(--radius-md);
		padding: 1.5rem;
		margin: 2rem 0;
		border-left: 4px solid var(--amber);
	}

	.article-content :global(.prompt-block p) {
		margin: 0;
	}

	.article-content :global(.prompt-label) {
		color: var(--amber);
		font-weight: 700;
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		margin-bottom: 0.75rem;
		display: block;
	}

	/* Essential box */
	.article-content :global(.essential-box) {
		background: linear-gradient(135deg, rgba(217, 119, 87, 0.05) 0%, rgba(217, 119, 87, 0.02) 100%);
		border: 1px solid rgba(217, 119, 87, 0.2);
		border-radius: var(--radius-md);
		padding: 1.5rem 2rem;
		margin: 2rem 0;
	}

	.article-content :global(.essential-box h2) {
		margin-top: 0;
	}

	@media (max-width: 768px) {
		.article-main {
			padding-top: 80px;
			padding-left: 1rem;
			padding-right: 1rem;
		}

		.article-content {
			font-size: 1rem;
		}
	}
</style>
