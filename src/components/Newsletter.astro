---
import { NEWSLETTER_URL } from '../consts';
---

<section class="newsletter-cta">
	<div class="newsletter-inner">
		<div class="newsletter-text">
			<h2 class="newsletter-title">📦 Le Cartable IA</h2>
			<p class="newsletter-desc">
				Recevez chaque semaine un prompt testé en classe, un outil nouveau, et une idée concrète pour préparer vos cours plus vite. Pas de spam, pas de théorie — que de la pratique.
			</p>
		</div>
		<div class="newsletter-action">
			<a href={NEWSLETTER_URL} class="newsletter-btn" target="_blank" rel="noopener">
				S'inscrire gratuitement →
			</a>
			<p class="newsletter-fineprint">Désinscription en 1 clic.</p>
		</div>
	</div>
</section>

<style>
	.newsletter-cta {
		background: linear-gradient(135deg, var(--navy) 0%, #243b55 100%);
		border-radius: var(--radius-lg);
		padding: 3rem 2.5rem;
		margin: 3rem 0;
		position: relative;
		overflow: hidden;
	}

	.newsletter-cta::before {
		content: '';
		position: absolute;
		top: -50%;
		right: -10%;
		width: 300px;
		height: 300px;
		background: radial-gradient(circle, rgba(217, 119, 87, 0.15) 0%, transparent 70%);
		border-radius: 50%;
	}

	.newsletter-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
		position: relative;
		z-index: 1;
	}

	.newsletter-title {
		color: white;
		font-size: 1.6rem;
		margin: 0 0 0.5rem 0;
	}

	.newsletter-desc {
		color: rgba(255, 255, 255, 0.7);
		font-size: 1rem;
		line-height: 1.6;
		margin: 0;
		max-width: 480px;
	}

	.newsletter-action {
		text-align: center;
		flex-shrink: 0;
	}

	.newsletter-btn {
		display: inline-block;
		background: var(--amber);
		color: white;
		font-weight: 700;
		font-size: 1.05rem;
		padding: 0.9rem 2rem;
		border-radius: var(--radius-md);
		text-decoration: none;
		transition: all 0.3s ease;
		white-space: nowrap;
	}

	.newsletter-btn:hover {
		transform: translateY(-2px);
		box-shadow: 0 8px 24px rgba(217, 119, 87, 0.4);
	}

	.newsletter-fineprint {
		color: rgba(255, 255, 255, 0.4);
		font-size: 0.8rem;
		margin: 0.75rem 0 0 0;
	}

	@media (max-width: 768px) {
		.newsletter-cta {
			padding: 2rem 1.5rem;
		}
		.newsletter-inner {
			flex-direction: column;
			text-align: center;
		}
		.newsletter-desc {
			max-width: 100%;
		}
	}
</style>
