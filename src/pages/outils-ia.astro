---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const outilsPosts = allPosts.filter(post => post.id.includes('outil-'));

const catColors: Record<string, { icon: string; gradient: string; color: string }> = {
	'Préparer':     { icon: '📘', gradient: 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)', color: '#6d5bd0' },
	'Différencier': { icon: '🧩', gradient: 'linear-gradient(135deg, #f093fb 0%, #4facfe 100%)', color: '#c94fc8' },
	'Évaluer':      { icon: '✅', gradient: 'linear-gradient(135deg, #43e97b 0%, #38f9d7 100%)', color: '#199a5e' },
	'Outils':       { icon: '🔧', gradient: 'linear-gradient(135deg, #fccb90 0%, #d57eeb 100%)', color: '#d7853a' },
	'Autres':       { icon: '📖', gradient: 'linear-gradient(135deg, #a8edea 0%, #fed6e3 100%)', color: '#4a9d95' },
};
const readingTimeOf = (p: { body?: string }) =>
	Math.max(1, Math.round((p.body?.split(/\s+/).length ?? 0) / 200));
---

<Base title="Outils IA" description="Mes outils testés en classe pour gagner du temps.">
	<section class="tools-section">
		<header class="page-hero animate-in">
			<span class="section-label">🔧 Testés en classe</span>
			<h1 class="page-title">Outils IA</h1>
			<p class="page-sub">La boîte à outils du prof augmenté — chaque outil est testé en conditions réelles avant d'en parler.</p>
		</header>
		<div class="tools-grid">
			{outilsPosts.map((post) => {
				const cat = post.data.category || 'Autres';
				const cc = catColors[cat] || catColors['Autres'];
				return (
					<a href={`/article/${post.id}/`} class="tool-card animate-in">
						<div class="tool-card-image">
							{post.id === 'outil-diffit' ? (
								<img src="/images/diffit/diffit-homepage.png" alt={post.data.title} loading="lazy" />
							) : post.id === 'outil-magicschool' ? (
								<div class="tool-placeholder" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
									<span class="tool-icon">🧙</span>
								</div>
							) : post.id === 'outil-quizizz' ? (
								<div class="tool-placeholder" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
									<span class="tool-icon">🎮</span>
								</div>
							) : (
								<div class="tool-placeholder" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
									<span class="tool-icon">🔧</span>
								</div>
							)}
						</div>
						<div class="tool-card-body">
							<div class="card-meta-top">
								<span class="chip card-chip" style={`color: ${cc.color}; background: color-mix(in srgb, ${cc.color} 10%, transparent);`}>{cc.icon} {cat}</span>
								<span class="card-time">{readingTimeOf(post)} min</span>
							</div>
							<h3 class="tool-card-title">{post.data.title}</h3>
							<p class="tool-card-desc">{post.data.description}</p>
							<span class="card-cta">Découvrir <span aria-hidden="true">→</span></span>
						</div>
					</a>
				);
			})}
		</div>
	</section>
</Base>

<style>
	.tools-section {
		padding: 2rem 0 4rem;
	}

	.page-hero {
		text-align: center;
		padding: 1rem 0 1rem;
	}

	.page-title {
		font-size: clamp(2.4rem, 5vw, 3.4rem);
		margin-bottom: 0.6rem;
	}

	.page-sub {
		color: var(--text-muted);
		font-size: 1.12rem;
		max-width: 560px;
		margin: 0 auto;
	}

	.tools-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2rem;
		padding: 2.5rem 0;
	}

	.tool-card {
		background: var(--surface);
		border-radius: var(--radius-lg);
		overflow: hidden;
		text-decoration: none;
		color: inherit;
		border: 1px solid var(--border);
		transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.35s ease, border-color 0.3s ease;
		display: flex;
		flex-direction: column;
		box-shadow: var(--shadow-soft);
	}

	.tool-card:hover {
		transform: translateY(-6px);
		box-shadow: var(--shadow-lg);
		border-color: rgba(217, 119, 87, 0.35);
	}

	.tool-card-image {
		width: 100%;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		position: relative;
		background: var(--bg-warm);
	}

	.tool-card-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		margin: 0;
		border-radius: 0;
		max-width: none;
		transition: transform 0.4s ease;
	}

	.tool-card:hover .tool-card-image img {
		transform: scale(1.05);
	}

	.tool-placeholder {
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.tool-icon {
		font-size: 3.5rem;
		opacity: 0.9;
		filter: drop-shadow(0 2px 4px rgba(0,0,0,0.2));
	}

	.tool-card-body {
		padding: 1.5rem;
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
	}

	.card-meta-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.card-chip {
		font-size: 0.76rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}

	.card-time {
		font-size: 0.82rem;
		color: var(--text-muted);
		font-weight: 600;
	}

	.tool-card-title {
		font-size: 1.15rem;
		margin: 0;
		color: var(--heading);
		line-height: 1.35;
	}

	.tool-card-desc {
		margin: 0;
		font-size: 0.92rem;
		color: var(--text-muted);
		line-height: 1.55;
		flex: 1;
	}

	.card-cta {
		color: var(--amber-dark);
		font-weight: 800;
		font-size: 0.9rem;
	}

	@media (max-width: 900px) {
		.tools-grid {
			grid-template-columns: repeat(2, 1fr);
			gap: 1.5rem;
		}
	}

	@media (max-width: 560px) {
		.tools-grid {
			grid-template-columns: 1fr;
			gap: 1.25rem;
		}
		.tool-card-body {
			padding: 1.25rem;
		}
	}
</style>
