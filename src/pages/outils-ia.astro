---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const outilsPosts = allPosts.filter(post => post.id.includes('outil-'));
---

<Base title="Outils IA" description="Mes outils testés en classe pour gagner du temps.">
    <section class="tools-section">
        <h1 class="page-title animate-in">Outils IA</h1>
        <div class="tools-grid">
            {outilsPosts.map((post) => (
                <a href={`/article/${post.id}/`} class="tool-card animate-in">
                    <div class="tool-card-image">
                        {post.id === 'outil-diffit' ? (
                            <img src="/images/diffit/diffit-homepage.png" alt={post.data.title} loading="lazy" />
                        ) : post.id === 'outil-magicschool' ? (
                            <div class="tool-placeholder" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                                <span class="tool-icon">🧙</span>
                            </div>
                        ) : post.id === 'outil-quizizz' ? (
                            <div class="tool-placeholder" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
                                <span class="tool-icon">🎮</span>
                            </div>
                        ) : (
                            <div class="tool-placeholder" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
                                <span class="tool-icon">🔧</span>
                            </div>
                        )}
                    </div>
                    <div class="tool-card-body">
                        <h3 class="tool-card-title">{post.data.title}</h3>
                    </div>
                </a>
            ))}
        </div>
    </section>
</Base>

<style>
    .tools-section {
        padding: 2rem 0 4rem;
    }

    .page-title {
        font-size: 2.2rem;
        margin-bottom: 0.5rem;
    }

    .tools-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;
        padding: 2rem 0;
    }

    .tool-card {
        background: var(--surface);
        border-radius: var(--radius-lg);
        overflow: hidden;
        text-decoration: none;
        color: inherit;
        border: 1px solid var(--border);
        transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
        display: flex;
        flex-direction: column;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    }

    .tool-card:hover {
        transform: scale(1.03);
        box-shadow: 0 20px 40px rgba(0,0,0,0.12), 0 8px 16px rgba(0,0,0,0.06);
        border-color: rgba(217, 119, 87, 0.3);
    }

    .tool-card-image {
        width: 100%;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        position: relative;
        background: var(--bg-warm);
    }

    .tool-card-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        margin: 0;
        border-radius: 0;
        max-width: none;
        transition: transform 0.4s ease;
    }

    .tool-card:hover .tool-card-image img {
        transform: scale(1.05);
    }

    .tool-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .tool-icon {
        font-size: 3.5rem;
        opacity: 0.9;
        filter: drop-shadow(0 2px 4px rgba(0,0,0,0.2));
    }

    .tool-card-body {
        padding: 1.5rem;
        flex: 1;
        display: flex;
        align-items: center;
    }

    .tool-card-title {
        font-size: 1.15rem;
        margin: 0;
        color: var(--navy);
        line-height: 1.3;
        text-align: center;
        width: 100%;
    }

    @media (max-width: 900px) {
        .tools-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 1.5rem;
        }
    }

    @media (max-width: 560px) {
        .tools-grid {
            grid-template-columns: 1fr;
            gap: 1.25rem;
        }
        
        .tool-card-body {
            padding: 1.25rem;
        }
    }
</style>
