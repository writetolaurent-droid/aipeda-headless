---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const blogPosts = allPosts.filter(post => post.id && !post.id.startsWith('outil-') && !post.id.startsWith('defi-'));

// Thematic gradient + icon per article
const styleMap = {
  'exercices-differencies-ia':      { icon: '📝', gradient: 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)' },
  'khanmigo-avis-prof':             { icon: '🤖', gradient: 'linear-gradient(135deg, #f093fb 0%, #f5576c 100%)' },
  'visuels-tableaux-ia':            { icon: '🎨', gradient: 'linear-gradient(135deg, #4facfe 0%, #00f2fe 100%)' },
  'correction-rapide':              { icon: '✅', gradient: 'linear-gradient(135deg, #43e97b 0%, #38f9d7 100%)' },
  'creer-supports-cours-ia':        { icon: '📚', gradient: 'linear-gradient(135deg, #fa709a 0%, #fee140 100%)' },
  'grilles-evaluation-ia':          { icon: '📊', gradient: 'linear-gradient(135deg, #a18cd1 0%, #fbc2eb 100%)' },
  'workflow-30min-sequence':        { icon: '⚡', gradient: 'linear-gradient(135deg, #fccb90 0%, #d57eeb 100%)' },
  'quiz-interactif-ia':             { icon: '🎯', gradient: 'linear-gradient(135deg, #e0c3fc 0%, #8ec5fc 100%)' },
  'rituels-classe':                 { icon: '🔁', gradient: 'linear-gradient(135deg, #f5576c 0%, #ff6f91 100%)' },
  'methode-pareto-sequence':        { icon: '📐', gradient: 'linear-gradient(135deg, #667eea 0%, #43e97b 100%)' },
  'methode-pareto':                 { icon: '📈', gradient: 'linear-gradient(135deg, #ffecd2 0%, #fcb69f 100%)' },
  'feedback-rapide-ia':             { icon: '💬', gradient: 'linear-gradient(135deg, #89f7fe 0%, #66a6ff 100%)' },
  'automatiser-correction-ia':      { icon: '🤖', gradient: 'linear-gradient(135deg, #13547a 0%, #80d0c7 100%)' },
  'ameliorer-sequence-pedagogique': { icon: '🔄', gradient: 'linear-gradient(135deg, #d4fc79 0%, #96e6a1 100%)' },
  'adaptation-dys-ia':              { icon: '🧩', gradient: 'linear-gradient(135deg, #f093fb 0%, #4facfe 100%)' },
  'progression-annuelle-ia':        { icon: '🗺️', gradient: 'linear-gradient(135deg, #a1c4fd 0%, #c2e9fb 100%)' },
};

const fallback = { icon: '📖', gradient: 'linear-gradient(135deg, #a8edea 0%, #fed6e3 100%)' };
---

<Base title="Blog" description="Tutos, réflexions et workflows pour les profs augmentés.">
    <section class="tools-section">
        <h1 class="page-title animate-in">Blog</h1>
        <div class="blog-intro animate-in">
            <p>Tutos, workflows et réflexions pour automatiser le répétitif et réhumaniser la classe.</p>
        </div>
        <div class="tools-grid">
            {blogPosts.map((post) => {
                const s = styleMap[post.id] || fallback;
                return (
                    <a href={`/article/${post.id}/`} class="tool-card animate-in">
                        <div class="tool-card-image">
                            <div class="tool-placeholder" style={`background: ${s.gradient};`}>
                                <span class="tool-icon">{s.icon}</span>
                            </div>
                        </div>
                        <div class="tool-card-body">
                            <h3 class="tool-card-title">{post.data.title}</h3>
                        </div>
                    </a>
                );
            })}
        </div>
    </section>
</Base>

<style>
    .tools-section {
        padding: 2rem 0 4rem;
    }

    .page-title {
        font-size: 2.2rem;
        margin-bottom: 0.5rem;
    }

    .blog-intro p {
        color: var(--text-muted);
        font-size: 1.1rem;
        margin-bottom: 1rem;
    }

    .tools-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;
        padding: 2rem 0;
    }

    .tool-card {
        background: var(--surface);
        border-radius: var(--radius-lg);
        overflow: hidden;
        text-decoration: none;
        color: inherit;
        border: 1px solid var(--border);
        transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
        display: flex;
        flex-direction: column;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    }

    .tool-card:hover {
        transform: scale(1.03);
        box-shadow: 0 20px 40px rgba(0,0,0,0.12), 0 8px 16px rgba(0,0,0,0.06);
        border-color: rgba(217, 119, 87, 0.3);
    }

    .tool-card-image {
        width: 100%;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        position: relative;
        background: var(--bg-warm);
    }

    .tool-card-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        margin: 0;
        border-radius: 0;
        max-width: none;
        transition: transform 0.4s ease;
    }

    .tool-card:hover .tool-card-image img {
        transform: scale(1.05);
    }

    .tool-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .tool-icon {
        font-size: 3.5rem;
        opacity: 0.9;
        filter: drop-shadow(0 2px 4px rgba(0,0,0,0.2));
    }

    .tool-card-body {
        padding: 1.5rem;
        flex: 1;
        display: flex;
        align-items: center;
    }

    .tool-card-title {
        font-size: 1.05rem;
        margin: 0;
        color: var(--navy);
        line-height: 1.3;
        text-align: center;
        width: 100%;
    }

    @media (max-width: 900px) {
        .tools-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 1.5rem;
        }
    }

    @media (max-width: 560px) {
        .tools-grid {
            grid-template-columns: 1fr;
            gap: 1.25rem;
        }
        .tool-card-body {
            padding: 1.25rem;
        }
    }
</style>
