---
import Base from '../layouts/Base.astro';
import { CONTACT_EMAIL, SOCIAL_LINKS } from '../consts';
---

<Base
	title="Contact"
	description="Une question, un retour, une envie de collaborer ? Contactez Laurent."
>
	<!-- Hero -->
	<section class="page-hero">
		<span class="section-label">💬 Parlons pédagogie</span>
		<h1>Restons en contact</h1>
		<p class="page-sub">
			Une question sur un outil&nbsp;? Un retour sur un article&nbsp;? Une envie de collaborer&nbsp;?
		</p>
	</section>

	<!-- Cartes de contact -->
	<section class="contact-grid">
		<article class="contact-card featured">
			<div class="icon-tile" style="--acc: #d97757;">✉️</div>
			<h3>Email</h3>
			<p>Pour toute question ou suggestion.</p>
			<a href={`mailto:${CONTACT_EMAIL}`} class="contact-link">{CONTACT_EMAIL} <span aria-hidden="true">→</span></a>
		</article>

		<article class="contact-card">
			<div class="icon-tile" style="--acc: #764ba2;">📺</div>
			<h3>YouTube</h3>
			<p>Chaîne Laurent / Mintavocado — démos, tutos, retours d'expérience.</p>
			<a href={SOCIAL_LINKS.youtube} target="_blank" rel="noopener" class="contact-link">
				Laurent sur YouTube <span aria-hidden="true">→</span>
			</a>
		</article>

		<article class="contact-card">
			<div class="icon-tile" style="--acc: #4facfe;">💬</div>
			<h3>Communauté</h3>
			<p>Discutez avec d'autres enseignants qui testent l'IA au quotidien.</p>
			<a href="/blog/" class="contact-link">Rejoindre la conversation <span aria-hidden="true">→</span></a>
		</article>
	</section>

	<!-- Note finale -->
	<section class="contact-note">
		<p>Chaque retour nourrit le laboratoire. 🧪</p>
	</section>
</Base>

<style>
	/* === Hero === */
	.page-hero {
		text-align: center;
		padding: 1rem 0 1rem;
	}

	.page-hero h1 {
		font-size: clamp(2.4rem, 5vw, 3.4rem);
		margin-bottom: 0.6rem;
	}

	.page-sub {
		color: var(--text-muted);
		font-size: 1.12rem;
		max-width: 540px;
		margin: 0 auto;
	}

	/* === Cartes === */
	.contact-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 1.5rem;
		max-width: 960px;
		margin: 2.5rem auto 0;
		align-items: stretch;
	}

	.contact-card {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		padding: 2.2rem 1.6rem;
		text-align: center;
		box-shadow: var(--shadow-soft);
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.35s ease, border-color 0.3s ease;
	}

	.contact-card:hover {
		transform: translateY(-5px);
		box-shadow: var(--shadow-md);
		border-color: color-mix(in srgb, var(--acc) 35%, transparent);
	}

	.contact-card.featured {
		border-color: color-mix(in srgb, var(--amber) 45%, var(--border));
		background: color-mix(in srgb, var(--amber) 6%, var(--surface));
	}

	.icon-tile {
		width: 54px;
		height: 54px;
		border-radius: 15px;
		display: grid;
		place-items: center;
		font-size: 1.55rem;
		margin: 0 auto 0.8rem;
		background: color-mix(in srgb, var(--acc) 14%, transparent);
		border: 1px solid color-mix(in srgb, var(--acc) 24%, transparent);
	}

	.contact-card h3 {
		margin: 0;
		color: var(--heading);
	}

	.contact-card p {
		color: var(--text-muted);
		font-size: 0.92rem;
		line-height: 1.6;
		margin: 0;
		flex: 1;
	}

	.contact-link {
		display: inline-block;
		margin-top: 0.7rem;
		color: var(--amber-dark);
		font-weight: 800;
		font-size: 0.95rem;
		text-decoration: none;
		transition: transform 0.2s ease;
	}

	.contact-link:hover {
		transform: translateX(3px);
	}

	/* === Note === */
	.contact-note {
		text-align: center;
		margin-top: 2.5rem;
	}

	.contact-note p {
		color: var(--text-muted);
		font-size: 0.98rem;
	}
</style>
