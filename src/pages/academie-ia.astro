---
import Base from '../layouts/Base.astro';
---

<Base
	title="Académie IA"
	description="Future plateforme de formation pour devenir un Prof Augmenté."
>
	<section class="section container">
		<div class="card text-center">
			<span class="section-tag">En préparation</span>
			<h1>Académie IA : Formez-vous</h1>
			<p>Je travaille sur une formation complète pour vous apprendre à déployer vos propres agents IA pédagogiques.</p>
			<p><strong>Concrète, pratique, immédiatement applicable.</strong></p>
			<div class="mt-2">
				<a href="/contact/" class="btn btn-primary">Être prévenu de l'ouverture</a>
			</div>
		</div>
	</section>
</Base>
